# Every variable the app reads (src/recall_checker/config.py). Copy to .env for local runs;
# commented lines show the default. Placeholders only: never commit a real token.

# Homebox API base, as reached from where the app runs
HOMEBOX_URL=http://localhost:7745
# Homebox API key (Profile → API Keys); required
HOMEBOX_TOKEN=hb_xxxxxxxxxxxxxxxx
# Browser-facing Homebox URL, for links in alerts (default: HOMEBOX_URL)
# HOMEBOX_PUBLIC_URL=

# Space- or comma-separated Apprise URLs, and/or a path to an Apprise config file
APPRISE_URLS=
# APPRISE_CONFIG=

# Schedule: every CHECK_INTERVAL_HOURS, or CHECK_CRON (a crontab line, in TZ) if set
# CHECK_INTERVAL_HOURS=24
# CHECK_CRON=0 7 * * *
# RUN_ON_STARTUP=true
# TZ=America/New_York

# Tiers: low | medium | high
# MIN_NOTIFY_TIER=medium
# AUTO_WRITEBACK_TIER=high
# WRITEBACK=true
# RECALL_TAG_NAME=Recall
# PURCHASE_GRACE_DAYS=365

# Recall feeds
# RECALL_SOURCES=cpsc,nhtsa
# NHTSA_TYPES=C,E
# CPSC_BASE_URL=https://www.saferproducts.gov/RestWebServices/Recall
# NHTSA_FLAT_FILE_URL=https://static.nhtsa.gov/odi/ffdd/rcl/FLAT_RCL_POST_2010.zip

# SQLite location (the image uses /data)
DATA_DIR=./data
LOG_LEVEL=INFO

# Web UI
# UI_HOST=0.0.0.0
# UI_PORT=8080
# Browser-facing URL of the UI; its host name is allowed by default
PUBLIC_URL=
# Comma-separated host names the UI answers to (default: PUBLIC_URL's host, any IP, localhost)
ALLOWED_HOSTS=
